{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.ts",
    "demos/**/*.ts",
    "previews/**/*.ts",
    "statusline/**/*.ts",
    "sticky-models/**/*.ts",
    "working-messages/**/*.ts"
  ]
}
